# サーバーポート
PORT=3000

# JWTトークン署名用シークレット（本番では必ず変更すること）
JWT_SECRET=change-me-to-a-long-random-string

# 管理画面ログイン用パスワード（本番では必ず変更すること）
ADMIN_PASSWORD=change-me

# Lark（Feishu）カスタムボットの Webhook URL
# Lark グループ > ボットを追加 > カスタムボット で発行されるURLを設定
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Lark署名検証を使う場合のシークレット（未使用なら空でよい）
LARK_WEBHOOK_SECRET=
