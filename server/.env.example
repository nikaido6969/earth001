# サーバーポート
PORT=3000

# JWTトークン署名用シークレット（本番では必ず変更すること）
JWT_SECRET=change-me-to-a-long-random-string

# 管理画面ログイン用パスワード（本番では必ず変更すること）
ADMIN_PASSWORD=change-me

# 事業者のログイン保持日数。一度ログインしたら再度パスワードを求めない運用のため長めに設定する
OPERATOR_SESSION_DAYS=180

# =========================
# Lark 通知設定
# =========================
# 通知方式: app = 個人へDM（試験運用: 二階堂さん宛） / webhook = グループのカスタムボット（本番: 塩尻市）
LARK_MODE=app

# --- LARK_MODE=app のとき（Lark開発者コンソールでアプリを作成し、im:message 権限を付与） ---
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DM送信先。まずは二階堂さん宛のテスト送信に使う
LARK_RECEIVE_ID=kenseinikaido@icloud.com
LARK_RECEIVE_ID_TYPE=email
# 中国版Feishuの場合は https://open.feishu.cn に変更
LARK_BASE_URL=https://open.larksuite.com

# --- LARK_MODE=webhook のとき（塩尻市グループのカスタムボット） ---
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=

# =========================
# 塩尻市マスタ（Googleスプレッドシート）
# =========================
MASTER_SPREADSHEET_ID=1w2mCb17sKs0DS6C2nKwtAffxLCnN-gvhIN-3ZAo-8kY
MASTER_SHEET_GID=848607191
# サービスアカウントのJSONキーを1行にして設定する。
# 作成したサービスアカウントのメールアドレスに、上記スプレッドシートの「編集者」権限を付与すること。
GOOGLE_SERVICE_ACCOUNT_JSON=

# =========================
# 試験導入スコープ（青果物：りんご・ぶどう類の取り扱い事業者）
# =========================
# 対象事業者名（部分一致・カンマ区切り）。空にすると事業者名での絞り込みをしない
TARGET_OPERATORS=ベジサコ,ファームシンセイ
# 対象返礼品名のキーワード（部分一致・カンマ区切り）。空にすると返礼品名での絞り込みをしない
TARGET_PRODUCT_KEYWORDS=りんご,リンゴ,サンふじ,シナノ,ぐんま名月,ふじ,ぶどう,ブドウ,シャインマスカット,クイーンルージュ,ナガノパープル,巨峰,ピオーネ,デラウェア
